[Unit]
Description=Obsidian MCP server (stdio) exposed over Streamable HTTP via supergateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/obsidian-remote-mcp
ExecStart=/usr/bin/node /home/YOUR_USER/obsidian-remote-mcp/node_modules/supergateway/dist/index.js \
  --stdio "/usr/bin/node /home/YOUR_USER/obsidian-remote-mcp/node_modules/obsidian-mcp/build/main.js '/home/YOUR_USER/Documents/YourVault'" \
  --outputTransport streamableHttp \
  --port 8420 \
  --stateful \
  --sessionTimeout 3600000 \
  --healthEndpoint /healthz \
  --logLevel info
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths="/home/YOUR_USER/Documents/YourVault"
# supergateway binds every interface and has no --host flag, so port 8420 would
# otherwise serve the unauthenticated MCP to the whole LAN. Only the auth server
# on loopback may reach it.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
