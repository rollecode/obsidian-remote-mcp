[Unit]
Description=Obsidian MCP server over Streamable HTTP, one shared vault index for all sessions
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/obsidian-remote-mcp
ExecStart=/usr/bin/node /home/YOUR_USER/obsidian-remote-mcp/vault-mcp.js --http 8420 '/home/YOUR_USER/Documents/YourVault'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths="/home/YOUR_USER/Documents/YourVault"
# The server binds loopback already; this keeps it there if that ever changes.
IPAddressDeny=any
IPAddressAllow=localhost

[Install]
WantedBy=multi-user.target
